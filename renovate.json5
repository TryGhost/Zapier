{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    extends: [
        'local>TryGhost/renovate-config',
    ],
    packageRules: [
        {
            description: 'Keep zapier-platform-core and zapier-platform-cli below v20: platform majors change the deployed Zapier Lambda runtime (the current major, 19, runs on Node 22) and need a coordinated push/promote/staged migrate via the publish workflow, so each new major is a deliberate manual upgrade and must never ride an automated Renovate merge. The CLI (used by the preview/publish workflows) must stay on the same major as core, so both share the rule.',
            matchPackageNames: ['zapier-platform-core', 'zapier-platform-cli'],
            allowedVersions: '<20',
        },
        {
            description: 'Keep pnpm on 10.x: pnpm 11 requires Node 22.13 or newer, but this repo supports any Node 22 (`engines.node: >=22`, `.nvmrc: v22`), and the shared preset automerges `packageManager` bumps, so a pnpm 11 update would silently drop support for Node 22.0-22.12.',
            matchPackageNames: ['pnpm'],
            allowedVersions: '<11',
        },
        {
            description: "Keep Node updates on 22: the Zapier Lambda runtime for core 19 is Node 22, the e2e job runs Ghost on the same Node 22, which Ghost's engines allow, and `.nvmrc` mirrors both. The shared preset automerges these bumps, so without this rule a major bump would silently drift CI and local dev off the deployed runtime. Patch/minor bumps within 22 stay in range and may automerge. The rule matches the dependency name, `node`, which both managers give it: Renovate looks up setup-node's `node-version` under the package name `actions/node-versions`, so a package name match never held the e2e job back.",
            matchManagers: ['github-actions', 'nvm'],
            matchDepNames: ['node'],
            allowedVersions: '<23',
        },
        {
            description: "Automerge minor and patch updates to pnpm overrides. An override here pins a transitive dependency past a security advisory, and Renovate keeps the pinned version current, but the shared preset only automerges direct dependency types, so these updates waited on a person even when CI passed. A major update moves every package the override covers onto a new major, so it still waits for review.",
            matchDepTypes: ['pnpm.overrides'],
            matchUpdateTypes: ['minor', 'patch'],
            automerge: true,
        },
    ],
}
